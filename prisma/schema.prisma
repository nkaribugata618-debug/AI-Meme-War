generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  role          Role          @default(HOST)
  competitions  Competition[]
  createdAt     DateTime      @default(now())
}

enum Role {
  HOST
  ADMIN
}

model Competition {
  id          String        @id @default(uuid())
  roomCode    String        @unique
  name        String
  hostId      String
  host        User          @relation(fields: [hostId], references: [id])
  status      CompStatus    @default(LOBBY)
  rounds      Round[]
  teams       Team[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([createdAt])
}

enum CompStatus {
  LOBBY
  ACTIVE
  COMPLETED
}

model Round {
  id            String        @id @default(uuid())
  competitionId String
  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  roundNumber   Int
  prompt        String
  timerEndsAt   DateTime?
  status        RoundStatus   @default(SETUP)
  winnerCommentary String?    // Generated by AI after round completes
  submissions   Submission[]
  createdAt     DateTime      @default(now())

  @@index([competitionId])
  @@index([createdAt])
}

enum RoundStatus {
  SETUP
  ACTIVE
  LOCKED
  PRESENTATION
  VOTING
  COMPLETED
}

model Team {
  id            String        @id @default(uuid())
  name          String
  joinCode      String        @unique
  competitionId String
  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  submissions   Submission[]
  createdAt     DateTime      @default(now())

  @@index([competitionId])
}

model Submission {
  id            String      @id @default(uuid())
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roundId       String
  round         Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  imageUrl      String?
  captionTop    String?
  captionBottom String?
  state         Json?
  isFinal       Boolean     @default(false)
  aiScore       Int?        // Scored automatically when submissions close
  aiCommentary  String?     // Short roast/compliment for presentation
  votes         Vote[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([teamId])
  @@index([roundId])
  @@index([createdAt])
}

model Vote {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voterSession String
  createdAt    DateTime   @default(now())

  @@unique([submissionId, voterSession])
  @@index([submissionId])
  @@index([voterSession])
  @@index([createdAt])
}
